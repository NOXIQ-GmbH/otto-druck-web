{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otto-druck-kundenportal",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "PORTAL_DB",
      "database_name": "otto-druck-portal-db",
      "database_id": "HIER-NACH-ANLAGE-DIE-D1-ID-EINTRAGEN"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PORTAL_UPLOADS",
      "bucket_name": "otto-druck-portal-uploads"
    }
  ]
}

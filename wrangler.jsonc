{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otto-druck-web",
  "account_id": "ecba8d5ed40cbb3eef9758f8a320fa39",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otto-druck-db",
      "database_id": "75a3c772-243a-4705-b80f-339699f2f37e"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "otto-druck-uploads",
      "jurisdiction": "eu"
    }
  ]
}